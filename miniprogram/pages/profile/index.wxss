.container {
  padding: 0 0 40rpx;
  background: var(--bg-page);
}

/* === 头部:深色主绿 + 渐变,头像带阴影 === */
.profile-card {
  position: relative;
  margin-bottom: 24rpx;
  background: transparent;
}

.profile-bg {
  height: 280rpx;
  background: linear-gradient(180deg, var(--primary-deep) 0%, var(--primary-color) 60%, var(--primary-light) 100%);
}

.profile-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: -96rpx;
  padding: 0 32rpx 32rpx;
  position: relative;
}

.guest-profile {
  padding: 0 48rpx 24rpx;
}

.avatar {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  border: 6rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  background: #FFFFFF;
}

.nickname {
  font-size: var(--text-h2);
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 20rpx;
}

.guest-hint {
  font-size: var(--text-small);
  color: var(--text-tertiary);
  margin-top: 8rpx;
  text-align: center;
}

.profile-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.profile-tag {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--primary-light);
  font-size: var(--text-small);
  color: var(--primary-color);
  font-weight: 500;
  border: 1rpx solid rgba(47, 168, 102, 0.18);
}

/* === 数据统计:白色圆角卡片 === */
.stats-card {
  margin: 0 24rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--card-radius);
  padding: 32rpx 24rpx;
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 0 8rpx;
}

.stat-num {
  font-size: var(--text-data-md);
  font-weight: 700;
  color: var(--primary-color);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  font-size: var(--text-small);
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: var(--border-light);
}

/* === 编辑资料按钮 === */
.edit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0 24rpx 24rpx;
  padding: 18rpx 0;
  border-radius: var(--btn-radius);
  font-size: var(--text-body);
  color: var(--primary-color);
  background: var(--bg-card);
  border: 1px solid var(--primary-color);
  font-weight: 500;
  transition: background 0.2s;
}

.edit-btn:active {
  background: var(--primary-light);
}

/* === 菜单:独立圆角卡片,左侧浅绿图标容器 === */
.menu-card {
  margin: 0 24rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--card-radius);
  padding: 0 24rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.menu-title {
  font-size: var(--text-body);
  color: var(--text-primary);
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--text-tertiary);
  font-size: var(--text-small);
}

.about {
  text-align: center;
  padding: 48rpx;
}

.about-text {
  font-size: var(--text-small);
  color: var(--text-quaternary);
}
