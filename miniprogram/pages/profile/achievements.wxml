<view class="container">
  <!-- 进度概览 -->
  <view class="progress-card card">
    <view class="progress-header">
      <view class="progress-title">成就进度</view>
      <view class="progress-count">{{stats.unlocked}}/{{stats.total}}</view>
    </view>
    <van-progress percentage="{{stats.progress}}" stroke-height="8" color="#2BB673" track-color="#F5F5FA"/>
    <view class="progress-text">已解锁 {{stats.progress}}% 的成就</view>
  </view>

  <!-- 成就分类 -->
  <view wx:for="{{categories}}" wx:key="type" class="category-section">
    <view class="category-title">{{item.type}}</view>
    <view class="achievement-grid">
      <view class="achievement-item {{achievement.unlocked ? 'unlocked' : 'locked'}}" wx:for="{{item.achievements}}" wx:for-item="achievement" wx:key="id">
        <image wx:if="{{achievement.iconUrl}}" class="achievement-icon-img" src="{{achievement.iconUrl}}" mode="aspectFit"/>
        <view wx:else class="achievement-icon">🏅</view>
        <view class="achievement-info">
          <text class="achievement-name">{{achievement.name}}</text>
          <text class="achievement-desc">{{achievement.description}}</text>
        </view>
        <view class="achievement-status">
          <van-icon name="{{achievement.unlocked ? 'success' : 'lock'}}" size="20px" color="{{achievement.unlocked ? '#4CAF50' : '#CCC'}}"/>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <empty-state wx:if="{{categories.length === 0}}" icon="🏅" title="暂无成就" description="开始训练，解锁你的第一个成就！"></empty-state>
</view>
