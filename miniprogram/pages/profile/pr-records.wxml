<view class="container">
  <!-- PR列表 -->
  <view class="pr-list" wx:if="{{prList.length > 0}}">
    <view class="pr-card card" wx:for="{{prList}}" wx:key="exerciseId" bindtap="goExerciseDetail" data-id="{{item.exerciseId}}">
      <image class="exercise-img" src="{{item.demoImageUrl || '/images/exercise-default.png'}}" mode="aspectFill"/>
      <view class="pr-info">
        <view class="exercise-name">{{item.exerciseName}}</view>
        <view class="pr-stats">
          <view class="pr-stat">
            <text class="stat-value">{{item.maxWeight || '-'}}</text>
            <text class="stat-label">最大重量(kg)</text>
          </view>
          <view class="pr-stat">
            <text class="stat-value">{{item.reps || '-'}}</text>
            <text class="stat-label">次数</text>
          </view>
        </view>
        <view class="last-date" wx:if="{{item.achievedDate}}">
          <van-icon name="clock-o" size="12px" color="#999"/>
          <text>达成日期: {{formatDate(item.achievedDate)}}</text>
        </view>
      </view>
      <van-icon name="arrow" color="#CCCCCC"/>
    </view>
  </view>

  <!-- 空状态 -->
  <empty-state wx:else icon="🏆" title="暂无PR记录" description="开始训练，创造你的个人最佳！"></empty-state>
</view>
