<view class="container">
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:if="{{!loading && post}}" class="detail">
    <view class="post-card">
      <view class="post-header">
        <view class="user-info" data-userid="{{post.userId}}" bindtap="goToProfile">
          <image src="{{post.avatarUrl || '/images/avatar-default.png'}}" class="avatar"/>
          <view class="user-detail">
            <text class="nickname">{{post.nickname || '匿名用户'}}</text>
            <text class="time">{{post.createdAt}}</text>
          </view>
        </view>
      </view>

      <view class="post-content">
        <text class="content-text">{{post.content}}</text>
      </view>

      <view wx:if="{{post.images.length > 0}}" class="post-images">
        <image
          wx:for="{{post.images}}"
          wx:for-item="img"
          wx:key="index"
          src="{{img}}"
          mode="aspectFill"
          class="post-image"
          data-imgs="{{post.images}}"
          data-index="{{index}}"
          bindtap="previewImage"
        />
      </view>

      <view class="post-actions">
        <view class="action-item {{post.isLiked ? 'liked' : ''}}" bindtap="onLike">
          <text class="action-icon">{{post.isLiked ? '❤️' : '🤍'}}</text>
          <text class="action-count">{{post.likeCount || 0}}</text>
        </view>
        <view class="action-item">
          <text class="action-icon">💬</text>
          <text class="action-count">{{comments.length || 0}}</text>
        </view>
      </view>
    </view>

    <view class="comment-section">
      <view class="section-title">评论 ({{comments.length}})</view>

      <view wx:if="{{comments.length === 0}}" class="comment-empty">
        <text>还没有评论，快来抢沙发吧</text>
      </view>

      <view wx:for="{{comments}}" wx:key="id" class="comment-item">
        <view class="comment-user" data-userid="{{item.userId}}" bindtap="goToProfile">
          <image src="{{item.avatarUrl || '/images/avatar-default.png'}}" class="comment-avatar"/>
        </view>
        <view class="comment-body">
          <view class="comment-header">
            <text class="comment-nickname">{{item.nickname}}</text>
            <text class="comment-time">{{item.createdAt}}</text>
          </view>
          <text class="comment-content">{{item.content}}</text>
          <view
            wx:if="{{item.parentId}}"
            class="comment-reply"
            data-commentid="{{item.parentId}}"
            data-nickname="{{item.replyNickname}}"
            bindtap="setReply"
          >
            <text class="reply-arrow">↳</text>
            <text class="reply-nickname">@{{item.replyNickname}}</text>
          </view>
          <view class="comment-actions">
            <text
              class="reply-btn"
              data-commentid="{{item.id}}"
              data-nickname="{{item.nickname}}"
              bindtap="setReply"
            >回复</text>
          </view>
        </view>
      </view>
    </view>

    <view class="comment-input-area {{replyingTo ? 'has-reply' : ''}}">
      <view wx:if="{{replyingTo}}" class="reply-hint">
        <text>回复 @{{replyingTo.nickname}}</text>
        <text class="cancel-reply" bindtap="cancelReply">取消</text>
      </view>
      <view class="input-row">
        <input
          class="input"
          placeholder="{{replyingTo ? '回复 ' + replyingTo.nickname : '说点什么...' }}"
          value="{{commentText}}"
          bindinput="onInput"
          maxlength="512"
        />
        <button class="submit-btn" bindtap="onSubmitComment">发送</button>
      </view>
    </view>
  </view>
</view>
