.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

.detail {
  padding: 20rpx;
}

.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-content {
  margin-bottom: 20rpx;
}

.content-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -5rpx;
  margin-bottom: 20rpx;
}

.post-image {
  width: 210rpx;
  height: 210rpx;
  margin: 5rpx;
  border-radius: 8rpx;
}

.post-actions {
  display: flex;
  justify-content: flex-start;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 10rpx 30rpx 10rpx 0;
}

.action-item.liked .action-icon {
  color: #ff4757;
}

.action-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.action-count {
  font-size: 24rpx;
  color: #666;
}

.comment-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
}

.comment-empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

.comment-item {
  display: flex;
  margin-bottom: 30rpx;
}

.comment-item:last-child {
  margin-bottom: 0;
}

.comment-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.comment-nickname {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.comment-time {
  font-size: 20rpx;
  color: #999;
}

.comment-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}

.comment-reply {
  margin-top: 10rpx;
  padding: 10rpx;
  background: #f5f5f5;
  border-radius: 6rpx;
}

.reply-arrow {
  color: #999;
  margin-right: 8rpx;
}

.reply-nickname {
  font-size: 24rpx;
  color: #666;
}

.comment-actions {
  margin-top: 10rpx;
}

.reply-btn {
  font-size: 22rpx;
  color: #999;
}

.comment-input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 20rpx;
  z-index: 100;
}

.comment-input-area.has-reply {
  border-top-color: #07c160;
}

.reply-hint {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #07c160;
  margin-bottom: 10rpx;
}

.cancel-reply {
  color: #999;
}

.input-row {
  display: flex;
  align-items: center;
}

.input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.submit-btn {
  margin-left: 20rpx;
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}
