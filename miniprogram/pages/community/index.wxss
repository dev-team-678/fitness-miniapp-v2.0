.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.tabs {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab-list {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.tab-item {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 30rpx;
  position: relative;
}

.tab-item.active {
  color: #333;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #07c160;
  border-radius: 2rpx;
}

.post-list {
  padding: 20rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.btn-share {
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
}

.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-content {
  margin-bottom: 20rpx;
}

.content-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -5rpx;
  margin-bottom: 20rpx;
}

.post-image {
  width: 220rpx;
  height: 220rpx;
  margin: 5rpx;
  border-radius: 8rpx;
}

.workout-share {
  display: flex;
  align-items: center;
  background: #f0f9f0;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.workout-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.workout-text {
  flex: 1;
  font-size: 26rpx;
  color: #07c160;
}

.arrow {
  font-size: 32rpx;
  color: #07c160;
}

.post-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
}

.action-item.liked .action-icon {
  color: #ff4757;
}

.action-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.action-count,
.action-text {
  font-size: 24rpx;
  color: #666;
}

.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 24rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 24rpx;
}

.fab-publish {
  position: fixed;
  right: 40rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: #2FA866;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(47, 168, 102, 0.4);
  z-index: 99;
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  line-height: 1;
}
