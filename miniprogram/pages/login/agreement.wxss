.agreement-page {
  padding: 40rpx 32rpx;
  background: #fff;
  min-height: 100vh;
}

.agreement-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A1A2E;
  text-align: center;
  margin-bottom: 40rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.agreement-body {
  font-size: 28rpx;
  color: #444;
  line-height: 1.9;
  white-space: pre-wrap;
}