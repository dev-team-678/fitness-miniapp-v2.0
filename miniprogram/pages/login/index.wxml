<view class="login-page">
  <view class="logo-area">
    <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
    <text class="app-name">运动健身助手</text>
    <text class="app-desc">科学训练 · 智能计划 · AI 助手</text>
  </view>

  <view class="login-area">
    <van-button
      type="primary"
      block
      round
      loading="{{loading}}"
      loading-text="登录中..."
      custom-class="login-btn {{!agreed ? 'disabled' : ''}}"
      disabled="{{!agreed}}"
      bind:click="onLogin"
    >
      微信一键登录
    </van-button>

    <view class="agreement-row" bindtap="toggleAgreement">
      <view class="checkbox {{agreed ? 'checked' : ''}}">
        <text wx:if="{{agreed}}" class="check-icon">✓</text>
      </view>
      <view class="agreement-text">
        <text>我已阅读并同意</text>
        <text class="link" catchtap="openUserAgreement">《用户服务协议》</text>
        <text>和</text>
        <text class="link" catchtap="openPrivacyPolicy">《隐私政策》</text>
      </view>
    </view>

    <view class="guest-link" bindtap="goGuestMode">
      <text class="guest-link-text">游客模式进入</text>
    </view>
  </view>
</view>
