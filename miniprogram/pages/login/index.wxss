.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: linear-gradient(180deg, #2FA866 0%, #F5F5FA 100%);
  padding: 0 60rpx;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 30rpx;
  border-radius: 36rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}

.login-area {
  width: 100%;
  padding: 0 20rpx;
}

.login-btn {
  background-color: #ffffff !important;
  color: #2FA866 !important;
  font-size: 32rpx;
  font-weight: bold;
  height: 88rpx;
}

.login-btn.disabled {
  opacity: 0.5;
}

/* 协议勾选区域 */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 36rpx;
  padding: 12rpx 0;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid rgba(255,255,255,0.6);
  border-radius: 50%;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #2FA866;
  border-color: #2FA866;
}

.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.agreement-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
}

.agreement-text .link {
  color: #fff;
  text-decoration: underline;
}

/* 游客模式入口 */
.guest-link {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
  padding: 16rpx 0;
}

.guest-link-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  letter-spacing: 2rpx;
}
