<view class="setup-page">
  <view class="setup-header">
    <text class="setup-title">完善个人信息</text>
    <text class="setup-desc">让教练更了解你</text>
  </view>

  <!-- 头像 -->
  <view class="avatar-section">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
      <view class="avatar-edit-icon">
        <text class="edit-icon-text">📷</text>
      </view>
    </button>
    <text class="avatar-tip">点击选择头像</text>
  </view>

  <!-- 昵称 -->
  <view class="form-section">
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input type="nickname" class="form-input" placeholder="请输入昵称"
             value="{{nickname}}" bindinput="onNicknameInput" bindblur="onNicknameBlur" />
    </view>
  </view>

  <!-- 按钮 -->
  <view class="btn-area">
    <van-button type="primary" block round
                loading="{{saving}}"
                loading-text="保存中..."
                disabled="{{saving}}"
                custom-style="background: #FF6B35; border-color: #FF6B35; height: 88rpx; font-size: 32rpx;"
                bind:click="onSave">
      保存并进入
    </van-button>
    <view class="skip-link" bindtap="onSkip">
      <text class="skip-text">跳过，稍后设置</text>
    </view>
  </view>
</view>
