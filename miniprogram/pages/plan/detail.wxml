<view class="container">
  <!-- 计划头部 -->
  <view class="plan-header card">
    <view class="plan-cover" wx:if="{{plan.coverImageUrl}}">
      <image src="{{plan.coverImageUrl}}" mode="aspectFill"></image>
    </view>
    <view class="plan-title">{{plan.name}}</view>
    <view class="plan-desc">{{plan.description}}</view>
    <view class="plan-tags">
      <van-tag type="primary" size="medium">{{difficultyLabel}}</van-tag>
      <van-tag type="success" size="medium" wx:if="{{goalLabel}}">{{goalLabel}}</van-tag>
      <van-tag type="warning" size="medium" wx:if="{{plan.isSystem}}">系统推荐</van-tag>
    </view>
    <view class="plan-info-grid">
      <view class="info-item">
        <text class="info-value">{{plan.durationWeeks}}</text>
        <text class="info-label">周</text>
      </view>
      <view class="info-item">
        <text class="info-value">{{plan.daysPerWeek}}</text>
        <text class="info-label">天/周</text>
      </view>
      <view class="info-item" wx:if="{{plan.avgDurationMin}}">
        <text class="info-value">{{plan.avgDurationMin}}</text>
        <text class="info-label">分钟/次</text>
      </view>
    </view>
  </view>

  <!-- 日历视图 -->
  <view class="calendar-section card">
    <plan-calendar 
      plan-id="{{planId}}" 
      current-week="{{currentWeek}}"
      bind:weekChange="onCalendarWeekChange"
      bind:dayTap="onCalendarDayTap"
    />
  </view>

  <!-- 周选择 -->
  <view class="week-selector">
    <view class="section-title">📋 详细安排</view>
    <scroll-view scroll-x class="week-scroll">
      <view class="week-tabs">
        <view class="week-tab {{currentWeek === (item + 1) ? 'active' : ''}}" 
              wx:for="{{weekCount}}" wx:key="*this"
              bindtap="onWeekChange" data-week="{{item + 1}}">
          第{{item + 1}}周
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 每日训练安排 -->
  <view class="day-list">
    <view class="day-card card" wx:for="{{currentDays}}" wx:key="id">
      <view class="day-header" bindtap="toggleDay" data-index="{{index}}">
        <view class="day-info">
          <view class="day-label">
            <text class="day-name">周{{weekdays[item.dayOfWeek - 1]}}</text>
            <text class="day-tag" wx:if="{{item.dayLabel}}">{{item.dayLabel}}</text>
          </view>
          <view class="day-rest" wx:if="{{!item.exercises || item.exercises.length === 0}}">🛌 休息日</view>
        </view>
        <van-icon name="{{item.expanded ? 'arrow-up' : 'arrow-down'}}" color="#999" />
      </view>
      
      <view class="day-exercises" wx:if="{{item.expanded && item.exercises && item.exercises.length > 0}}">
        <view class="exercise-item" wx:for="{{item.exercises}}" wx:for-item="ex" wx:key="id">
          <view class="exercise-index">{{index + 1}}</view>
          <view class="exercise-info">
            <text class="exercise-name">{{ex.exerciseName}}</text>
            <view class="exercise-detail">
              <text wx:if="{{ex.sets}}">{{ex.sets}}组</text>
              <text wx:if="{{ex.reps}}"> × {{ex.reps}}次</text>
              <text wx:if="{{ex.restSeconds}}"> | 休息{{ex.restSeconds}}s</text>
            </view>
            <text class="exercise-notes" wx:if="{{ex.notes}}">💡 {{ex.notes}}</text>
          </view>
          <view class="exercise-type-tag">
            <van-tag size="mini" type="{{ex.exerciseType === 'strength' ? 'primary' : 'success'}}">
              {{ex.exerciseType === 'strength' ? '力量' : '有氧'}}
            </van-tag>
          </view>
        </view>

        <view class="day-action" wx:if="{{item.exercises.length > 0}}">
          <van-button type="primary" round block size="small" 
                      custom-style="background: #FF6B35; border-color: #FF6B35;"
                      bindtap="startWorkout" data-day-id="{{item.id}}">
            开始训练
          </van-button>
        </view>
      </view>

      <view class="day-exercises" wx:if="{{item.expanded && (!item.exercises || item.exercises.length === 0)}}">
        <view class="rest-day-tip">
          <text>好好休息，为下一次训练蓄力 💪</text>
        </view>
      </view>
    </view>
  </view>
</view>
