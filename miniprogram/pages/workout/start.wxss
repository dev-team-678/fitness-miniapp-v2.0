.workout-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 40rpx;
}

/* === 计时栏:深绿品牌色,专注感 === */
.timer-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, var(--primary-deep) 0%, #1F3B2E 100%);
  color: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(47, 168, 102, 0.18);
}

.timer-left {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.timer-text {
  font-size: 64rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: 2rpx;
  color: #FFFFFF;
  line-height: 1;
}

.timer-text.paused {
  color: var(--warning-color);
}

.timer-label {
  font-size: var(--text-small);
  color: var(--warning-color);
  font-weight: 500;
  padding: 4rpx 12rpx;
  background: rgba(250, 173, 20, 0.18);
  border-radius: 8rpx;
}

.timer-actions {
  display: flex;
  gap: 20rpx;
}

.timer-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: background 0.2s;
}

.timer-btn:active {
  background: rgba(255, 255, 255, 0.24);
}

.finish-btn {
  background: rgba(245, 34, 45, 0.22);
  border-color: rgba(245, 34, 45, 0.3);
}

.finish-btn:active {
  background: rgba(245, 34, 45, 0.36);
}

/* === 进度条 === */
.progress-bar {
  padding: 20rpx 32rpx;
  background: var(--bg-card);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-small);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.progress-track {
  height: 8rpx;
  background: var(--border-light);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-color), var(--primary-soft));
  border-radius: 999rpx;
  transition: width 0.3s;
}

/* === 动作切换标签 === */
.exercise-tabs {
  white-space: nowrap;
  padding: 24rpx 32rpx;
  background: var(--bg-card);
  margin-bottom: 16rpx;
}

.exercise-tab {
  display: inline-block;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  border-radius: var(--btn-radius);
  background: var(--bg-input);
  text-align: center;
  min-width: 120rpx;
  border: 1rpx solid transparent;
  transition: all 0.2s;
}

.exercise-tab.active {
  background: var(--primary-light);
  border-color: var(--primary-color);
}

.exercise-tab.done {
  background: rgba(47, 168, 102, 0.08);
}

.tab-name {
  display: block;
  font-size: var(--text-small);
  color: var(--text-primary);
  font-weight: 500;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exercise-tab.active .tab-name {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-count {
  display: block;
  font-size: var(--text-tiny);
  color: var(--text-tertiary);
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.exercise-tab.active .tab-count {
  color: var(--primary-color);
}

/* === 当前动作卡片 === */
.current-exercise {
  padding: 32rpx;
}

.exercise-header {
  margin-bottom: 24rpx;
}

.exercise-name {
  font-size: var(--text-h2);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.exercise-target {
  font-size: var(--text-body);
  color: var(--primary-color);
  font-weight: 500;
  display: inline-block;
  padding: 6rpx 16rpx;
  background: var(--primary-light);
  border-radius: 8rpx;
}

/* === 已完成组列表 === */
.sets-list {
  margin-bottom: 24rpx;
  background: var(--bg-card);
  border-radius: var(--card-radius);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.sets-header {
  display: flex;
  padding: 16rpx 24rpx;
  background: var(--bg-elevated);
  font-size: var(--text-tiny);
  color: var(--text-tertiary);
  font-weight: 500;
}

.set-row {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light);
  align-items: center;
}

.set-row:last-child {
  border-bottom: none;
}

.set-row.latest {
  background: var(--primary-light);
}

.set-col {
  flex: 1;
  text-align: center;
  font-size: var(--text-body);
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.set-num {
  font-weight: 700;
  color: var(--primary-color);
}

/* === 输入区域 === */
.set-input-area {
  background: var(--bg-card);
  border-radius: var(--card-radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.set-input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.set-input-label {
  font-size: var(--text-h3);
  font-weight: 700;
  color: var(--primary-color);
}

.input-row {
  display: flex;
  gap: 24rpx;
}

.input-group {
  flex: 1;
}

.input-label {
  font-size: var(--text-small);
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.set-input {
  width: 100%;
  height: 88rpx;
  background: var(--bg-input);
  border-radius: var(--input-radius);
  text-align: center;
  font-size: var(--text-h3);
  font-weight: 600;
  color: var(--text-primary);
  box-sizing: border-box;
  padding: 0 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.set-input:focus {
  background: #FFFFFF;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 4rpx rgba(47, 168, 102, 0.12);
}

/* === 动作导航 === */
.nav-buttons {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
}

/* === 空状态 === */
.empty-workout {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: var(--text-h3);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: var(--text-body);
  color: var(--text-tertiary);
}

/* === 休息弹窗 === */
.rest-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.rest-card {
  width: 600rpx;
  background: var(--bg-card);
  border-radius: 32rpx;
  padding: 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.rest-title {
  font-size: var(--text-h3);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 32rpx;
}

.rest-circle {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  border: 8rpx solid var(--primary-light);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--primary-light) 100%);
}

.rest-time {
  font-size: 96rpx;
  font-weight: 700;
  color: var(--primary-color);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.rest-unit {
  font-size: var(--text-small);
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.rest-progress {
  height: 8rpx;
  background: var(--border-light);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.rest-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-color), var(--primary-soft));
  border-radius: 999rpx;
  transition: width 1s linear;
}

.rest-actions {
  display: flex;
  justify-content: center;
}

/* === 训练感受弹窗 === */
.feeling-sheet {
  padding: 48rpx 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.feeling-title {
  font-size: var(--text-h2);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
}

.feeling-options {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.feeling-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.feeling-item.selected {
  background: var(--primary-light);
  border-color: var(--primary-color);
  transform: scale(1.05);
}

.feeling-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.feeling-label {
  font-size: var(--text-small);
  color: var(--text-secondary);
}

.feeling-item.selected .feeling-label {
  color: var(--primary-color);
  font-weight: 600;
}
