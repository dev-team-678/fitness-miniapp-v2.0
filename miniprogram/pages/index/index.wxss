.container {
  padding: 24rpx;
  padding-bottom: 120rpx;
  background: var(--bg-page);
}

/* === 游客登录引导:渐变 + 圆角 === */
.guest-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(180deg, var(--primary-soft) 0%, var(--primary-color) 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(47, 168, 102, 0.18);
}

.guest-content {
  flex: 1;
  margin-right: 24rpx;
}

.guest-title {
  display: block;
  font-size: var(--text-body);
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.guest-desc {
  display: block;
  font-size: var(--text-small);
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.5;
}

/* === 顶部问候 === */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 8rpx 0;
}

.greeting {
  flex: 1;
}

.greeting-text {
  font-size: var(--text-h2);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.streak-badge {
  display: inline-block;
  background: var(--primary-light);
  color: var(--primary-color);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: var(--text-small);
  font-weight: 500;
  border: 1rpx solid rgba(47, 168, 102, 0.18);
}

.header-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-left: 24rpx;
  border: 3rpx solid var(--bg-card);
  box-shadow: 0 2rpx 8rpx rgba(47, 168, 102, 0.18);
}

.header-avatar image {
  width: 100%;
  height: 100%;
}

/* === 今日计划卡片 === */
.today-plan {
  padding: 32rpx;
}

.plan-header {
  margin-bottom: 24rpx;
}

.plan-tag {
  font-size: var(--text-small);
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}

.plan-name {
  font-size: var(--text-h2);
  font-weight: 600;
  color: var(--text-primary);
}

.plan-day-label {
  font-size: var(--text-body);
  color: var(--primary-color);
  margin-top: 8rpx;
  font-weight: 500;
}

.plan-exercises {
  margin-bottom: 24rpx;
}

.plan-exercise-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.ex-name {
  font-size: var(--text-body);
  color: var(--text-primary);
}

.ex-detail {
  font-size: var(--text-body);
  color: var(--primary-color);
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.plan-more {
  padding: 12rpx 0;
  font-size: var(--text-small);
  color: var(--text-tertiary);
}

.plan-action {
  margin-top: 8rpx;
}

/* === 本周概览 === */
.week-overview {
  padding: 32rpx;
}

.week-days {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.week-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.day-label {
  font-size: var(--text-tiny);
  color: var(--text-tertiary);
}

.week-day.today .day-label {
  color: var(--primary-color);
  font-weight: 600;
}

.day-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-input);
  font-size: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.week-day.checked .day-dot {
  background: var(--primary-color);
  color: #FFFFFF;
}

.week-day.today .day-dot {
  border-color: var(--primary-color);
  background: var(--primary-light);
  color: var(--primary-color);
  font-weight: 700;
}

.week-day.today.checked .day-dot {
  background: var(--primary-color);
  color: #FFFFFF;
  border-color: var(--primary-color);
}

.day-check-icon {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1;
}

.week-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border-light);
}

.week-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: var(--text-data-sm);
  font-weight: 700;
  color: var(--primary-color);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  font-size: var(--text-small);
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

/* === 快速入口:浅绿圆角图标容器 === */
.quick-actions {
  padding: 32rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 16rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
  background: transparent;
  transition: background 0.2s;
}

.action-item:active {
  background: var(--primary-light);
}

.action-icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  position: relative;
  overflow: visible;
}

/* AI 入口:与其他 4 项同底色,仅用 AI 角标和文字主色作差异化 */
.action-icon-box.ai-icon::after {
  content: 'AI';
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #FAAD14;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  line-height: 1.4;
  box-shadow: 0 2rpx 6rpx rgba(250, 173, 20, 0.4);
}

.action-item:has(.ai-icon) .action-text {
  color: var(--primary-color);
  font-weight: 600;
}

.action-text {
  font-size: var(--text-small);
  color: var(--text-secondary);
  font-weight: 500;
}

/* === 打卡卡片 === */
.checkin-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: linear-gradient(180deg, #FFF8F0 0%, #FFEFE0 100%);
  border-radius: var(--card-radius);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(250, 173, 20, 0.18);
}

.checkin-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.checkin-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #FFE4C4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
}

.checkin-title {
  font-size: var(--text-body);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.checkin-desc {
  font-size: var(--text-small);
  color: var(--text-secondary);
  display: block;
  margin-top: 4rpx;
}
