.chat-history-page {
  min-height: 100vh;
  background: #F5F5FA;
  padding-bottom: env(safe-area-inset-bottom);
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-bar .title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.session-list {
  padding: 16rpx 0;
}

.session-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #fff;
  margin-bottom: 2rpx;
}

.session-item:active {
  background: #f5f5f5;
}

.session-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6C5CE7, #a29bfe);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  font-size: 36rpx;
}

.session-info {
  flex: 1;
  overflow: hidden;
}

.session-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.session-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.msg-count {
  font-size: 24rpx;
  color: #999;
}

.session-time {
  font-size: 24rpx;
  color: #ccc;
}

.load-more {
  text-align: center;
  padding: 30rpx;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #ccc;
}
