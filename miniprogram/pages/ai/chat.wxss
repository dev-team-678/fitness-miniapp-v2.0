.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.chat-list {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 160rpx;
}

.date-header {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0;
}

.message-list {
  display: flex;
  flex-direction: column;
}

.message {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.message.user {
  flex-direction: row-reverse;
}

.message.longpress-active {
  opacity: 0.6;
}

.avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.user-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.message-content {
  margin: 0 20rpx;
}

.message.user .message-content {
  max-width: 500rpx;
}

.message.assistant .assistant-bubble {
  max-width: 620rpx;
}

/* 用户消息气泡 */
.user-text {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* AI 消息气泡 */
.rich-content {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
  word-break: break-word;
}

.rich-content .bold {
  font-weight: bold;
}

/* ---- 标题 ---- */
.md-h1 {
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #eee;
}

.md-h2 {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-top: 24rpx;
  margin-bottom: 12rpx;
}

.md-h3 {
  font-size: 28rpx;
  font-weight: bold;
  color: #444;
  margin-top: 20rpx;
  margin-bottom: 10rpx;
}

.md-h1:first-child, .md-h2:first-child, .md-h3:first-child {
  margin-top: 0;
}

/* ---- 段落 ---- */
.md-p {
  margin-bottom: 16rpx;
  line-height: 1.8;
}

/* ---- 表格 ---- */
.md-table {
  margin: 16rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #e8e8e8;
}

.table-scroll {
  white-space: nowrap;
}

.table-row {
  display: flex;
}

.table-row.header-row {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.table-row:not(.header-row) {
  background: #fafafa;
}

.table-row:not(.header-row):nth-child(even) {
  background: #f0f0f5;
}

.table-cell {
  flex: 1;
  min-width: 120rpx;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  line-height: 1.4;
  border-bottom: 1rpx solid #eee;
  color: #333;
  white-space: normal;
  word-break: break-all;
}

.header-row .table-cell {
  color: #fff;
  font-weight: bold;
  border-bottom-color: rgba(255,255,255,0.2);
}

.table-row:last-child .table-cell {
  border-bottom: none;
}

/* ---- 列表 ---- */
.md-list {
  margin: 12rpx 0;
}

.list-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
  line-height: 1.7;
}

.list-dot {
  color: #667eea;
  font-size: 32rpx;
  margin-right: 12rpx;
  margin-top: -2rpx;
  flex-shrink: 0;
}

.list-text {
  flex: 1;
}

/* ---- 时间戳 ---- */
.message-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.message.user .message-time {
  text-align: right;
}

/* ---- loading ---- */
.loading-tip {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 24rpx;
}

/* ---- 快捷提问 ---- */
.quick-actions {
  position: fixed;
  bottom: 160rpx;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: linear-gradient(to top, #f5f5f5 80%, transparent);
}

.quick-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.quick-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.quick-btn {
  padding: 16rpx 28rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #667eea;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

/* ---- 输入区 ---- */
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.chat-input {
  flex: 1;
  height: 70rpx;
  padding: 0 30rpx;
  background: #f5f5f5;
  border-radius: 35rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 70rpx;
  line-height: 70rpx;
  background: #ddd;
  color: #fff;
  border-radius: 35rpx;
  font-size: 26rpx;
  padding: 0;
}

.send-btn.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}
