<view class="container">
  <!-- 快捷入口 -->
  <view class="quick-actions card">
    <view class="action-item" bindtap="goMilestones">
      <view class="action-icon">🏆</view>
      <text class="action-text">里程碑</text>
    </view>
    <view class="action-item" bindtap="goRecord">
      <view class="action-icon">📝</view>
      <text class="action-text">记数据</text>
    </view>
  </view>

  <!-- 最新数据 -->
  <view class="latest-card card" wx:if="{{latestRecord}}">
    <view class="section-title">📊 最新数据</view>
    <view class="latest-grid">
      <view class="latest-item" wx:if="{{latestRecord.weightKg}}">
        <text class="latest-value">{{latestRecord.weightKg}}</text>
        <text class="latest-unit">kg</text>
        <text class="latest-label">体重</text>
      </view>
      <view class="latest-item" wx:if="{{latestRecord.bodyFatPct}}">
        <text class="latest-value">{{latestRecord.bodyFatPct}}</text>
        <text class="latest-unit">%</text>
        <text class="latest-label">体脂率</text>
      </view>
      <view class="latest-item" wx:if="{{latestRecord.muscleMassKg}}">
        <text class="latest-value">{{latestRecord.muscleMassKg}}</text>
        <text class="latest-unit">kg</text>
        <text class="latest-label">肌肉量</text>
      </view>
      <view class="latest-item" wx:if="{{latestRecord.bmi}}">
        <text class="latest-value">{{latestRecord.bmi}}</text>
        <text class="latest-unit"></text>
        <text class="latest-label">BMI</text>
      </view>
    </view>
  </view>

  <!-- 指标切换 -->
  <view class="metric-tabs card">
    <view class="metric-tab {{currentMetric === item.key ? 'active' : ''}}"
          wx:for="{{metrics}}" wx:key="key"
          bindtap="onMetricChange" data-key="{{item.key}}">
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- 图表 -->
  <view class="chart-card card">
    <view class="section-title">📈 趋势图</view>
    <view class="chart-area" wx:if="{{chartValues.length > 0}}">
      <canvas type="2d" id="chartCanvas" class="chart-canvas"
              style="width: {{chartWidth}}px; height: {{chartHeight}}px;"></canvas>
      <view class="chart-labels">
        <text wx:for="{{chartLabels}}" wx:key="index">{{item}}</text>
      </view>
      <view class="chart-values">
        <text wx:for="{{chartValues}}" wx:key="index" class="chart-value-dot">
          <text class="dot">●</text> {{item}}
        </text>
      </view>
    </view>
    <van-empty wx:else image="search" description="暂无数据，开始记录吧"></van-empty>
  </view>

  <!-- 记录列表 -->
  <view class="history-card card" wx:if="{{records.length > 0}}">
    <view class="section-title">📋 历史记录</view>
    <view class="record-row" wx:for="{{records}}" wx:key="index" wx:if="{{index < 10}}">
      <text class="record-date">{{item.date}}</text>
      <text class="record-value">{{item.value}}</text>
    </view>
  </view>

  <van-button type="primary" block round fixed="{{true}}" bottom="{{true}}"
              custom-style="background: linear-gradient(135deg, #FF6B35, #FF8F65); border: none; margin: 24rpx;"
              bindtap="goRecord">记录数据</van-button>
</view>
