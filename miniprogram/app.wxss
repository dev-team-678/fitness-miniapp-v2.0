/* 全局样式 - 高级感健康清新风 */
page {
  background-color: #F7FAF8;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #1D2129;
  line-height: 1.5;
}

/* 主色变量 - 沉稳品牌绿(降低饱和度) */
view {
  --primary-color: #2FA866;
  --primary-light: #E6F7EF;
  --primary-deep: #248A52;
  --primary-soft: #36BC76;
  --secondary-color: #1890FF;
  --success-color: #2FA866;
  --active-color: #1890FF;
  --warning-color: #FAAD14;
  --danger-color: #F5222D;

  --bg-page: #F7FAF8;
  --bg-card: #FFFFFF;
  --bg-input: #F2F3F5;
  --bg-elevated: #FAFCFB;

  --text-primary: #1D2129;
  --text-secondary: #4E5969;
  --text-tertiary: #86909C;
  --text-quaternary: #C9CDD4;

  --border-color: #E5E6EB;
  --border-light: #F2F3F5;

  --card-radius: 16rpx;
  --btn-radius: 12rpx;
  --pill-radius: 24rpx;
  --input-radius: 8rpx;
  --shadow-card: 0 2rpx 12rpx rgba(47, 168, 102, 0.08);
  --shadow-hover: 0 4rpx 16rpx rgba(47, 168, 102, 0.14);

  --text-h1: 40rpx;
  --text-h2: 36rpx;
  --text-h3: 32rpx;
  --text-body: 28rpx;
  --text-small: 24rpx;
  --text-tiny: 22rpx;
  --text-data-lg: 56rpx;
  --text-data-md: 40rpx;
  --text-data-sm: 32rpx;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: var(--bg-page);
}

/* 卡片样式 - 全局统一 */
.card {
  background: var(--bg-card);
  border-radius: var(--card-radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

/* 标题样式 */
.section-title {
  font-size: var(--text-h3);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.module-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.body-text {
  font-size: var(--text-body);
  color: var(--text-primary);
}

.helper-text {
  font-size: var(--text-small);
  color: var(--text-tertiary);
}

/* 主按钮 - 渐变 + 圆角 */
.btn-primary {
  background: linear-gradient(180deg, var(--primary-soft), var(--primary-color));
  color: #FFFFFF;
  border-radius: var(--btn-radius);
  font-size: var(--text-body);
  font-weight: 500;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(47, 168, 102, 0.22);
  transition: opacity 0.2s;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: var(--bg-card);
  color: var(--primary-color);
  border: 1px solid var(--primary-color);
  border-radius: var(--btn-radius);
  font-size: var(--text-body);
  font-weight: 500;
  height: 80rpx;
  line-height: 78rpx;
  text-align: center;
  box-sizing: border-box;
}

.btn-secondary:active {
  background: var(--primary-light);
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--input-radius);
  font-size: var(--text-tiny);
  font-weight: 500;
}

.tag-primary {
  background: var(--primary-light);
  color: var(--primary-color);
}

.tag-success {
  background: rgba(47, 168, 102, 0.12);
  color: var(--primary-color);
}

.tag-info {
  background: rgba(24, 144, 255, 0.1);
  color: var(--secondary-color);
}

.tag-warning {
  background: rgba(250, 173, 20, 0.12);
  color: var(--warning-color);
}

.tag-danger {
  background: rgba(245, 34, 45, 0.1);
  color: var(--danger-color);
}

/* 文本省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* Flex布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* 间距 */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.ml-8 { margin-left: 8rpx; }
.ml-16 { margin-left: 16rpx; }
.mr-8 { margin-right: 8rpx; }
.mr-16 { margin-right: 16rpx; }
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border-light);
  margin: 24rpx 0;
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 渐变背景(头部用) */
.gradient-header {
  background: linear-gradient(180deg, var(--primary-color) 0%, var(--primary-light) 100%);
}

.gradient-cta {
  background: linear-gradient(180deg, var(--primary-soft) 0%, var(--primary-color) 100%);
}

.gradient-progress {
  background: linear-gradient(90deg, var(--primary-color), var(--primary-soft));
}
